{
  "manifest_version": 3,
  "name": "YouTrack Task Status Updater",
  "version": "1.0.0",
  "description": "Получение статусов задач из YouTrack API",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.youtrack.ru/*",
    "https://youtrack.wildberries.ru/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
